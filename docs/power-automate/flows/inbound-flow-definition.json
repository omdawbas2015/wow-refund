{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "When_a_new_email_arrives_(V3)": {
      "type": "OpenApiConnectionNotification",
      "inputs": {
        "host": {
          "connectionName": "shared_office365",
          "operationId": "OnNewEmailV3",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
        },
        "parameters": {
          "folderPath": "Inbox",
          "importance": "Any",
          "fetchOnlyWithAttachment": false,
          "includeAttachments": false
        },
        "subscribe": {
          "method": "post",
          "uri": "@listCallbackUrl()"
        }
      },
      "description": "Trigger fires for every new mail in the refund-ops mailbox Inbox. Filters in the next steps drop emails that are not refund replies."
    }
  },
  "actions": {
    "Subject_lower": {
      "runAfter": {},
      "type": "Compose",
      "inputs": "@toLower(triggerOutputs()?['body/subject'])",
      "description": "Lowercase the subject so the substring match in Has_batch_id is case-insensitive."
    },
    "Has_batch_id": {
      "runAfter": {
        "Subject_lower": ["Succeeded"]
      },
      "type": "If",
      "expression": {
        "or": [
          { "contains": ["@outputs('Subject_lower')", "apb-"] },
          { "contains": ["@outputs('Subject_lower')", "knet-"] },
          { "contains": ["@outputs('Subject_lower')", "aura-"] }
        ]
      },
      "actions": {
        "Compose_request_body": {
          "runAfter": {},
          "type": "Compose",
          "inputs": {
            "fromEmail": "@{triggerOutputs()?['body/from']}",
            "toEmail": "@{triggerOutputs()?['body/to']}",
            "subject": "@{triggerOutputs()?['body/subject']}",
            "rawBody": "@{coalesce(triggerOutputs()?['body/body'], triggerOutputs()?['body/bodyPreview'], '')}",
            "powerAutomateRunId": "@{workflow().run.name}"
          },
          "description": "Materialise the exact JSON body to POST. Composing it once means the optional HMAC step (see Azure Function variant) signs the same bytes the webhook will verify."
        },
        "POST_to_webhook": {
          "runAfter": {
            "Compose_request_body": ["Succeeded"]
          },
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "<APP_BASE_URL>/api/webhooks/power-automate",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": "@outputs('Compose_request_body')"
          },
          "description": "Replace <APP_BASE_URL> with your platform URL (e.g. https://refund.example.com). NOTE: this default flow does not sign the body. The app must therefore have POWER_AUTOMATE_INBOUND_SECRET unset (or empty). For HMAC-secured production deployments, replace this action with the HTTP-call-to-Azure-Function pattern from docs/power-automate/azure-function-hmac/."
        }
      },
      "else": {
        "actions": {
          "Terminate_skipped": {
            "runAfter": {},
            "type": "Terminate",
            "inputs": {
              "runStatus": "Succeeded"
            },
            "description": "Email is unrelated to a refund batch — drop it without notifying the platform."
          }
        }
      }
    }
  },
  "outputs": {}
}
