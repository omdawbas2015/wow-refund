{
  "type": "object",
  "required": ["intent", "confidence"],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "APPROVAL_RESPONSE",
        "KNET_ARN_REPLY",
        "AURA_CONFIRMATION",
        "CUSTOMER_REPLY",
        "UNCLEAR"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "blanket": {
      "type": ["string", "null"],
      "enum": ["APPROVED", "REJECTED", null]
    },
    "perCase": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseNumber", "decision"],
        "additionalProperties": false,
        "properties": {
          "caseNumber": { "type": "string" },
          "decision": {
            "type": "string",
            "enum": ["APPROVED", "REJECTED"]
          }
        }
      }
    },
    "arns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caseNumber", "arn"],
        "additionalProperties": false,
        "properties": {
          "caseNumber": { "type": "string" },
          "arn": { "type": "string" }
        }
      }
    },
    "reason": {
      "type": "string"
    }
  }
}
