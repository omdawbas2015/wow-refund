{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "type": "object",
          "properties": {
            "templateKey": { "type": "string" },
            "to": { "type": "string" },
            "cc": { "type": ["string", "null"] },
            "bcc": { "type": ["string", "null"] },
            "subject": { "type": "string" },
            "body": { "type": "string" },
            "logId": { "type": "string" },
            "contextType": { "type": ["string", "null"] },
            "contextId": { "type": ["string", "null"] },
            "variables": { "type": "object" }
          },
          "required": ["to", "subject", "body"]
        }
      },
      "description": "WOW Refund app POSTs here to send an email through the operator's Outlook mailbox. Trigger URL contains a SAS token — keep it secret. Optional X-Wow-Signature HMAC header is logged for forensics; verification requires the optional Azure Function (see docs/power-automate/azure-function-hmac/)."
    }
  },
  "actions": {
    "Send_an_email_(V2)": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_office365",
          "operationId": "SendEmailV2",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
        },
        "parameters": {
          "emailMessage/To": "@triggerBody()?['to']",
          "emailMessage/Subject": "@triggerBody()?['subject']",
          "emailMessage/Body": "<pre style=\"font-family: ui-monospace, SFMono-Regular, Menlo, monospace; white-space: pre-wrap;\">@{triggerBody()?['body']}</pre>",
          "emailMessage/Importance": "Normal",
          "emailMessage/Cc": "@triggerBody()?['cc']",
          "emailMessage/Bcc": "@triggerBody()?['bcc']"
        }
      },
      "description": "Sends the email through the connected operator mailbox. Body is wrapped in <pre> so the plain-text alignment of cases / batches survives Outlook rendering."
    },
    "Return_200": {
      "runAfter": {
        "Send_an_email_(V2)": ["Succeeded"]
      },
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "runId": "@{workflow().run.name}",
          "logId": "@{triggerBody()?['logId']}",
          "delivered": true
        }
      }
    },
    "Return_500_on_failure": {
      "runAfter": {
        "Send_an_email_(V2)": ["Failed", "TimedOut"]
      },
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 500,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "runId": "@{workflow().run.name}",
          "logId": "@{triggerBody()?['logId']}",
          "delivered": false,
          "error": "Outlook send failed — check Power Automate run history."
        }
      }
    }
  },
  "outputs": {}
}
