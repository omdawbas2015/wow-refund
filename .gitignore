# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
out/
dist/
build/
.turbo/

# Environment files
.env
.env.local
.env.*.local

# Prisma / SQLite — never commit a database file or its WAL sidecar.
# Migration .sql files under packages/db/**/migrations/ are intentionally
# whitelisted below because they're text, not database snapshots.
*.db
*.db-journal
*.db-shm
*.db-wal
**/*.db
**/*.db-journal
**/dev.db
**/main.db
!packages/db/**/migrations/**/*.sql

# Backup artifacts produced by lib/backups/run-backup.ts
# Scoped to the repo root so source files under apps/web/src/lib/backups/
# (runner + storage code) are still tracked.
/backups/

# Next.js / TS build info
next-env.d.ts
tsconfig.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Coverage
coverage/
.nyc_output/

# Temp
tmp/
temp/
