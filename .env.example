# Copy to .env.local (or apps/web/.env.local) and fill in.
# .env files are gitignored — never commit a real one.

# ---------- Required for local dev ----------

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-bytes-of-entropy

# Local SQLite via Prisma. Production flips schema.prisma to postgresql.
DATABASE_URL="file:./dev.db"

# NextAuth needs to trust the host on localhost / preview deploys.
AUTH_TRUST_HOST=true

# Optional: which site URL NextAuth thinks it is.
# NEXTAUTH_URL=http://localhost:3000


# ---------- Cron / scheduled endpoints ----------

# Shared secret used by Vercel Cron (or any external scheduler) to call
# /api/cron/* endpoints. Generate with: openssl rand -base64 32.
# Endpoints accept either `x-cron-secret: <value>` or `Authorization: Bearer <value>`.
# CRON_SECRET=


# ---------- App backups ----------

# Where the backup runner writes artifacts by default when the admin UI
# leaves the destination path blank. Resolved relative to process.cwd().
# BACKUP_LOCAL_DIR=./backups

# S3 backup destination. Used when BackupSettings.destinationPath is set
# to s3://bucket/prefix. Credential precedence:
#   1. BACKUP_S3_* (dedicated, least-privilege — recommended)
#   2. AWS_* (shared app credentials)
# Region falls back to AWS_REGION / AWS_DEFAULT_REGION.
# Set BACKUP_S3_ENDPOINT for S3-compatible stores (MinIO, R2, Wasabi).
# BACKUP_S3_REGION=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_ENDPOINT=


# ---------- Power Automate (M365 email integration) ----------

# Outbound: app -> Power Automate webhook (sends customer/manager emails).
# POWER_AUTOMATE_WEBHOOK_URL=https://prod-<region>.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?...
# POWER_AUTOMATE_SIGNING_SECRET=

# Inbound: Power Automate -> app (classified replies land at /api/webhooks/power-automate).
# The Flow must compute HMAC-SHA256 of the raw request body using this secret
# and send it in the `x-wow-signature` header. Legacy Flows that send the
# plaintext secret are still accepted for backward compatibility (with a
# deprecation warning) — upgrade the Flow at your earliest convenience.
# POWER_AUTOMATE_INBOUND_SECRET=


# ---------- Optional production hardening ----------

# AES-256-GCM key for PII encryption helpers in lib/crypto/pii.ts.
# Generate with: openssl rand -hex 32   (must be 64 hex chars).
# When unset, encrypt() / decrypt() are pass-through and the app behaves
# as if the helpers weren't installed.
# PII_ENCRYPTION_KEY=

# Sentry SDK — SDK init is a no-op when DSN is unset, so this is safe to
# leave blank in dev. Source maps upload on build only when
# SENTRY_AUTH_TOKEN + SENTRY_ORG + SENTRY_PROJECT are all set.
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_ENV=development
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_TRACE_RATE=0.1

# Upstash Redis — enables (a) cross-replica fanout for the SSE
# notification stream in lib/events/bus.ts and (b) shared sliding-window
# rate limiting across replicas in lib/rate-limit/index.ts.
# Without these, single-replica fanout + in-memory rate limit work fine.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Self-hosted Redis for the K8s / docker-compose stack. Used by the SSE
# fanout adapter when set; falls back to in-process EventEmitter otherwise.
# REDIS_URL=redis://localhost:6379

# Email provider fallback (unused when Power Automate is configured).
# EMAIL_PROVIDER=postmark
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS="WOW Refund <noreply@wow.local>"

# Demo / seed flags
# SEED_DEMO_CASES=1


# ---------- Production-only ----------

# DIRECT_DATABASE_URL=  # Neon direct (non-pooled) URL for prisma migrate and pg_dump.
# NEXT_PUBLIC_APP_VERSION=  # set by build to git rev-parse --short HEAD.
